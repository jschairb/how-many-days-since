---
import '../styles/site.css';
import '../styles/norwester.css';
import {
  OG_IMAGE_HEIGHT,
  OG_IMAGE_TYPE,
  OG_IMAGE_WIDTH,
  OG_LOGO_PATH,
  OG_SITE_NAME,
  ogCardAlt,
  ogImagePathFor,
  resolveOgCard,
} from '../lib/og-card';
import { SITE_URL, canonicalUrl } from '../lib/canonical';
const site = SITE_URL;
const { active, title = 'How Many Days Since Michigan Has Beaten Ohio State?', description = 'The Ohio State-Michigan rivalry record and an evidence-labeled cross-era Rivalry Lab.', ogImage, ogImageAlt, schema } = Astro.props;
// Fixed to the trailing-slash form the sitemap publishes. Most pages are
// server-rendered, so a request-derived canonical would let `/record` and
// `/record/` each claim to be the original.
const canonical = canonicalUrl(Astro.url.pathname);
// Every page gets a card: its own generated one, or the site card as a fallback
// for routes the resolver does not know. `og:image` is never left off.
const openGraphImage = new URL(ogImage ?? ogImagePathFor(Astro.url.pathname), site).toString();
const openGraphImageAlt = ogImageAlt ?? (() => { const card = resolveOgCard(Astro.url.pathname); return card ? ogCardAlt(card) : description; })();
const openGraphLogo = new URL(OG_LOGO_PATH, site).toString();
const gaMeasurementId = import.meta.env.GA_MEASUREMENT_ID;
const webSiteSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'How Many Days Since Michigan Has Beaten Ohio State?', url: site });
const pageSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical });
const additionalSchema = schema ? JSON.stringify(schema) : undefined;
const nav = [{ href: '/', label: 'Home', id: 'count', icon: true }, { href: '/countdown', label: 'COUNTDOWN', id: 'countdown' }, { href: '/record', label: 'THE RECORD', id: 'record' }, { href: '/rivalry-lab', label: 'RIVALRY LAB', id: 'lab' }, { href: 'https://gwpworkshop.com/collections/rivalry-lab', label: 'MERCH', id: 'merch' }];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={OG_SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={openGraphImage} />
    <meta property="og:image:secure_url" content={openGraphImage} />
    <meta property="og:image:type" content={OG_IMAGE_TYPE} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={openGraphImageAlt} />
    <meta property="og:logo" content={openGraphLogo} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={openGraphImage} />
    <meta name="twitter:image:alt" content={openGraphImageAlt} />
    <script type="application/ld+json" set:html={webSiteSchema}></script>
    <script type="application/ld+json" set:html={pageSchema}></script>
    {additionalSchema && <script type="application/ld+json" set:html={additionalSchema}></script>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style is:global>[hidden]{display:none!important}</style>
    {gaMeasurementId && <><script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script><script is:inline define:vars={{ gaMeasurementId }}>window.dataLayer=window.dataLayer||[];function gtag(){{window.dataLayer.push(arguments)}}gtag('js',new Date());gtag('config',gaMeasurementId);</script></>}
  </head>
  <body>
    <header class="site-header"><nav class="site-nav" id="site-nav" aria-label="Site">{nav.map((item) => <a href={item.href} aria-label={item.icon ? item.label : undefined} target={item.id === 'merch' ? '_blank' : undefined} rel={item.id === 'merch' ? 'noopener noreferrer' : undefined} aria-current={active === item.id ? 'page' : undefined} class:list={{ active: active === item.id, 'site-nav-home': item.icon }}>{item.icon ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8v10h-6v-6H9v6H3z" /></svg> : item.label}</a>)}<div class="site-nav-share"><slot name="nav-share" /></div><button type="button" class="site-nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav"><span aria-hidden="true"></span></button></nav></header>
    <main class:list={{ 'site-main': true, lab: active === 'lab' }}><slot /></main>
    {active !== 'lab' && <footer class="site-footer">an <a href="https://github.com/jschairb">@jschairb</a> joint, from <a class="gwp" href="https://greatwesternproductions.com">Great Western Productions</a> · © {new Date().getFullYear()}</footer>}
  </body>
</html>

<script>
  const siteNav = document.getElementById('site-nav');
  const navToggle = siteNav?.querySelector<HTMLButtonElement>('.site-nav-toggle');

  if (siteNav && navToggle) {
    // The collapsed styling is only safe once the toggle can open it again.
    siteNav.classList.add('collapsible');

    const setOpen = (open: boolean) => {
      siteNav.classList.toggle('open', open);
      navToggle.setAttribute('aria-expanded', String(open));
    };

    navToggle.addEventListener('click', () => setOpen(!siteNav.classList.contains('open')));

    document.addEventListener('click', (event) => {
      if (!siteNav.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && siteNav.classList.contains('open')) {
        setOpen(false);
        navToggle.focus();
      }
    });

    // The links return to the bar above 560px, so drop the open state with them.
    matchMedia('(max-width: 560px)').addEventListener('change', (event) => {
      if (!event.matches) setOpen(false);
    });
  }
</script>

<style is:global>
   .site-nav-home { display:grid; place-items:center; width:18px; padding:0 0 4px; color:#8b9098!important; }
   .site-nav-home svg { width:16px; height:16px; fill:currentColor; }
   .site-nav-toggle { display:none; place-items:center; width:38px; height:38px; padding:0; border:2px solid #111; background:#fff; color:#111; cursor:pointer; }
   .site-nav-toggle span,.site-nav-toggle span::before,.site-nav-toggle span::after { display:block; width:17px; height:2px; background:currentColor; }
   .site-nav-toggle span { position:relative; }
   .site-nav-toggle span::before,.site-nav-toggle span::after { content:''; position:absolute; left:0; }
   .site-nav-toggle span::before { top:-5px; }
   .site-nav-toggle span::after { top:5px; }
   .site-nav-toggle[aria-expanded=true] { background:#111; color:#fff; }
   /* Above the breakpoint the slotted Share badge pins itself to the viewport
      corner, so it must not take a slot in the nav row. */
   .site-nav-share { display:contents; }

   /* Below 560px the five links outrun the bar, so all but the home icon
      collapse behind the toggle and stack under it. Every rule here is gated
      on .collapsible, which the nav script adds once it can drive the toggle.
      Without it the bar keeps its scrolling row and stays usable. */
   @media (max-width:560px) {
     .site-nav.collapsible { flex-wrap:wrap; align-items:center; overflow:visible; column-gap:16px; row-gap:0; padding-bottom:0; }
     /* The toggle trails the links in the markup; order keeps it on the bar
        row, opposite the home icon, so the opened links stack under both. */
     .site-nav.collapsible .site-nav-toggle { display:grid; order:-1; margin-left:auto; }
     .site-nav.collapsible .site-nav-home { order:-2; padding-bottom:0; }
     .site-nav.collapsible a:not(.site-nav-home) { display:none; width:100%; padding:15px 2px; border-top:1px solid #d9dce1; font-size:15px; }
     .site-nav.collapsible.open a:not(.site-nav-home) { display:block; }
     /* Share is the last row of the menu, not a floating badge. */
     .site-nav.collapsible .site-nav-share { display:none; width:100%; }
     .site-nav.collapsible.open .site-nav-share { display:block; }
     .site-nav.collapsible.open { padding-bottom:14px; }
   }
</style>
