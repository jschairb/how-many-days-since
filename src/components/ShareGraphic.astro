---
import { SHARE_WIDTH, SHARE_HEIGHT } from '../lib/share-graphic';

interface Props {
  referenceDate: string;
  siteUrl: string;
}

const { referenceDate, siteUrl } = Astro.props;
---

<div id="share-badge" data-reference-date={referenceDate} data-site-url={siteUrl}>
  <div id="share-clip">
    <button
      type="button"
      id="share-trigger"
      aria-haspopup="menu"
      aria-expanded="false"
      aria-controls="share-menu"
    >
      Share
    </button>
  </div>

  <div id="share-menu" role="menu" hidden>
    <button type="button" role="menuitem" id="share-copy" hidden>Copy image</button>
    <button type="button" role="menuitem" id="share-download">Download PNG</button>
    <a role="menuitem" id="share-x" href={siteUrl} rel="noopener" target="_blank">Post on X</a>
    <p id="share-status" role="status" aria-live="polite"></p>
  </div>

  <canvas id="share-canvas" width={SHARE_WIDTH} height={SHARE_HEIGHT} aria-hidden="true" hidden
  ></canvas>
</div>

<style>
  /* The badge is slotted into the site nav. Above the collapse breakpoint the
     ribbon and pill are pinned to the viewport corner, so the wrapper stays out
     of the nav row entirely; below it the trigger becomes a menu row. */
  #share-badge {
    display: contents;
  }

  /* Clips the diagonal band to the corner. Only the band takes clicks. */
  #share-clip {
    position: fixed;
    top: 0;
    right: max(40px, calc((100vw - 1080px) / 2));
    width: 132px;
    height: 132px;
    overflow: hidden;
    z-index: 50;
    pointer-events: none;
  }

  #share-trigger {
    pointer-events: auto;
    position: absolute;
    top: 30px;
    right: -46px;
    width: 180px;
    transform: rotate(45deg);
    padding: 0.45rem 0;
    border: none;
    background: #be2137;
    color: #fff;
    font-family: Impact, Charcoal, sans-serif;
    font-size: 1.05rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-align: center;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  }

  #share-trigger:hover,
  #share-trigger:focus-visible {
    background: #8f3642;
  }

  #share-menu {
    pointer-events: auto;
    position: fixed;
    top: 104px;
    right: max(40px, calc((100vw - 1080px) / 2));
    display: flex;
    flex-direction: column;
    min-width: 172px;
    padding: 0.35rem;
    background: #fff;
    border: 2px solid #be2137;
    border-radius: 8px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
  }

  #share-menu[hidden] {
    display: none;
  }

  #share-menu > button,
  #share-menu > a {
    font: bold 0.95rem/1 Arial, Helvetica, sans-serif;
    text-align: left;
    padding: 0.6rem 0.7rem;
    border: none;
    border-radius: 5px;
    background: none;
    color: #be2137 !important;
    text-decoration: none !important;
    cursor: pointer;
  }

  #share-menu > button[hidden] {
    display: none;
  }

  #share-menu > button:hover,
  #share-menu > a:hover {
    background: #be2137;
    color: #fff !important;
  }

  #share-status:empty {
    display: none;
  }

  #share-status {
    margin: 0.2rem 0.7rem 0.4rem;
    font: 0.75rem/1.35 Arial, Helvetica, sans-serif;
    color: #333;
    max-width: 160px;
  }

  /* Below ~905px the 640px column reaches the corner, so the diagonal band
     would sit on the headline. Swap to a pill tucked beside the nav. */
  @media (max-width: 904px) {
    #share-clip {
      top: 9px;
      right: 9px;
      width: auto;
      height: auto;
      overflow: visible;
    }

    #share-trigger {
      position: static;
      transform: none;
      width: auto;
      padding: 0.4rem 0.9rem;
      border-radius: 999px;
      font-size: 0.85rem;
      letter-spacing: 1.5px;
    }

    #share-menu {
      top: 52px;
      right: 9px;
    }
  }

  /* At the nav's collapse breakpoint the corner belongs to the hamburger, so
     Share stops floating and becomes the last row of the opened menu. The nav
     owns whether the row is shown; this block only owns how it looks. It is
     gated on the same .collapsible class, so when the nav script never runs
     the badge stays the corner pill it is above the breakpoint. */
  @media (max-width: 560px) {
    :global(.site-nav.collapsible) #share-clip {
      position: static;
      width: 100%;
      height: auto;
      overflow: visible;
      pointer-events: auto;
    }

    :global(.site-nav.collapsible) #share-trigger {
      display: block;
      width: 100%;
      padding: 15px 2px;
      border-top: 1px solid #d9dce1;
      border-radius: 0;
      background: none;
      color: #be2137;
      font: 600 15px 'IBM Plex Sans', Arial, sans-serif;
      letter-spacing: normal;
      text-align: left;
      box-shadow: none;
    }

    :global(.site-nav.collapsible) #share-trigger:hover,
    :global(.site-nav.collapsible) #share-trigger:focus-visible {
      background: none;
      color: #8f3642;
    }

    :global(.site-nav.collapsible) #share-menu {
      position: static;
      min-width: 0;
      padding: 0 0 4px 14px;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    :global(.site-nav.collapsible) #share-menu > button,
    :global(.site-nav.collapsible) #share-menu > a {
      padding: 11px 8px;
    }
  }
</style>

<script>
  import { calcDaysSince, formatEasternTime } from '../lib/days';
  import {
    SHARE_WIDTH,
    SHARE_HEIGHT,
    SHARE_HEADLINE,
    buildShareCaption,
    buildShareText,
    buildXIntentUrl,
    fitFontSize,
    formatCount,
    shareFileName,
    wrapText,
  } from '../lib/share-graphic';

  // Straight off the site's stylesheet, so the card reads as the page.
  const SCARLET = '#BB0000';
  const MUTED = '#6B717C';
  const HEADING_FONT = 'Archivo Black, Arial Black, Arial, sans-serif';
  const BODY_FONT = 'IBM Plex Sans, Arial, Helvetica, sans-serif';

  const badge = document.getElementById('share-badge');
  const canvas = document.getElementById('share-canvas') as HTMLCanvasElement | null;

  if (badge && canvas) {
    const referenceDate = new Date(badge.dataset.referenceDate ?? '');
    const siteUrl = badge.dataset.siteUrl ?? window.location.origin;

    const trigger = document.getElementById('share-trigger') as HTMLButtonElement;
    const menu = document.getElementById('share-menu') as HTMLDivElement;
    const copyBtn = document.getElementById('share-copy') as HTMLButtonElement;
    const downloadBtn = document.getElementById('share-download') as HTMLButtonElement;
    const xLink = document.getElementById('share-x') as HTMLAnchorElement;
    const status = document.getElementById('share-status') as HTMLParagraphElement;

    const currentDays = () => calcDaysSince(referenceDate, new Date());
    const say = (message: string) => {
      status.textContent = message;
    };

    const track = (method: string) => {
      const gtag = (window as any).gtag;
      if (typeof gtag === 'function') {
        gtag('event', 'share', { method, content_type: 'days_since_graphic' });
      }
    };

    /** Repaints the card as the current Count page: clean type, scarlet
     * counter, series panels, and the same restrained white space. */
    const draw = (days: number, now: Date) => {
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      ctx.clearRect(0, 0, SHARE_WIDTH, SHARE_HEIGHT);
      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(0, 0, SHARE_WIDTH, SHARE_HEIGHT);

      ctx.textAlign = 'center';
      ctx.textBaseline = 'alphabetic';
      ctx.fillStyle = '#111111';
      ctx.font = `52px ${HEADING_FONT}`;
      const lines = wrapText(SHARE_HEADLINE.toUpperCase(), SHARE_WIDTH - 180, (l) => ctx.measureText(l).width);
      let y = 104;
      for (const line of lines) {
        ctx.fillText(line, SHARE_WIDTH / 2, y);
        y += 58;
      }

      const countText = formatCount(days);
      const unitText = ' DAYS';
      const unitSize = 42;

      const countSize = fitFontSize(SHARE_WIDTH - 300, 190, 110, (size) => {
        ctx.font = `${size}px ${BODY_FONT}`;
        return ctx.measureText(countText).width;
      });

      ctx.font = `${countSize}px ${BODY_FONT}`;
      const countWidth = ctx.measureText(countText).width;
      ctx.font = `${unitSize}px ${BODY_FONT}`;
      const unitWidth = ctx.measureText(unitText).width;

      const baseline = 342;
      let x = (SHARE_WIDTH - (countWidth + unitWidth)) / 2;

      ctx.textAlign = 'left';
      ctx.fillStyle = SCARLET;
      ctx.font = `${countSize}px ${BODY_FONT}`;
      ctx.shadowColor = '#111111';
      ctx.shadowOffsetX = 5;
      ctx.shadowOffsetY = 5;
      ctx.shadowBlur = 0;
      ctx.fillText(countText, x, baseline);

      ctx.shadowColor = 'transparent';
      ctx.shadowOffsetX = 0;
      ctx.shadowOffsetY = 0;
      ctx.shadowBlur = 0;
      ctx.font = `${unitSize}px ${BODY_FONT}`;
      ctx.fillText(unitText, x + countWidth, baseline);

      ctx.textAlign = 'center';
      ctx.fillStyle = MUTED;
      ctx.font = `500 25px ${BODY_FONT}`;
      ctx.fillText(
        `It's ${formatEasternTime(now)} in Columbus and Michigan still sucks.`,
        SHARE_WIDTH / 2,
        402
      );

      ctx.strokeStyle = '#111111';
      ctx.lineWidth = 3;
      ctx.strokeRect(150, 452, 900, 98);
      ctx.fillStyle = SCARLET;
      ctx.font = `32px ${HEADING_FONT}`;
      ctx.fillText('OHIO STATE 27–9', 330, 512);
      ctx.fillStyle = '#111111';
      ctx.fillText('62–52–6', 600, 512);
      ctx.fillStyle = SCARLET;
      ctx.fillText('OSU SINCE 2012', 870, 512);
      ctx.fillStyle = MUTED;
      ctx.font = `20px ${BODY_FONT}`;
      ctx.fillText(siteUrl.replace(/^https?:\/\//, ''), SHARE_WIDTH / 2, 592);

      xLink.href = buildXIntentUrl(days, siteUrl);
    };

    const toBlob = (): Promise<Blob> =>
      new Promise((resolve, reject) => {
        canvas.toBlob(
          (blob) => (blob ? resolve(blob) : reject(new Error('Could not render the image.'))),
          'image/png'
        );
      });

    const supportsFileShare = (() => {
      try {
        const probe = new File([new Blob()], 'probe.png', { type: 'image/png' });
        return typeof navigator.canShare === 'function' && navigator.canShare({ files: [probe] });
      } catch {
        return false;
      }
    })();

    const supportsImageCopy =
      typeof ClipboardItem !== 'undefined' && typeof navigator.clipboard?.write === 'function';

    copyBtn.hidden = !supportsImageCopy;

    const closeMenu = () => {
      menu.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      say('');
    };

    const openMenu = () => {
      menu.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
    };

    // Where the share sheet takes files, one tap is the whole interaction.
    // Everywhere else the ribbon opens the menu of fallbacks.
    trigger.addEventListener('click', async () => {
      if (!supportsFileShare) {
        menu.hidden ? openMenu() : closeMenu();
        return;
      }

      const days = currentDays();
      try {
        const file = new File([await toBlob()], shareFileName(days), { type: 'image/png' });
        await navigator.share({ files: [file], text: buildShareText(days, siteUrl) });
        track('web_share');
      } catch (error) {
        if ((error as Error)?.name === 'AbortError') return;
        openMenu();
        say('Sharing failed. Try downloading instead.');
      }
    });

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.write([new ClipboardItem({ 'image/png': await toBlob() })]);
        say('Copied. Paste it into your post.');
        track('copy_image');
      } catch {
        say('Copying failed. Try downloading instead.');
      }
    });

    downloadBtn.addEventListener('click', async () => {
      const days = currentDays();
      try {
        const url = URL.createObjectURL(await toBlob());
        const link = document.createElement('a');
        link.href = url;
        link.download = shareFileName(days);
        link.click();
        URL.revokeObjectURL(url);
        say(buildShareCaption(days));
        track('download');
      } catch {
        say('Download failed. Try again in a moment.');
      }
    });

    xLink.addEventListener('click', () => track('x_intent'));

    document.addEventListener('click', (event) => {
      if (!menu.hidden && !badge.contains(event.target as Node)) closeMenu();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        closeMenu();
        trigger.focus();
      }
    });

    const render = () => draw(currentDays(), new Date());

    render();
    // Impact is a system face, but wait for webfonts before trusting metrics.
    document.fonts?.ready.then(render).catch(() => {});
    setInterval(render, 60 * 1000);
  }
</script>
