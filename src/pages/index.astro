---
import ShareGraphic from '../components/ShareGraphic.astro';
import SiteShell from '../components/SiteShell.astro';
import games from '../data/rivalry-games.json';
import { calcDaysSince } from '../lib/days';

const referenceDate = new Date('2024-11-30T17:00:00Z');
const now = new Date();
const days = calcDaysSince(referenceDate, now);
const totals = games.reduce((value, game) => ({ michigan: value.michigan + Number(game.winner === 'Michigan'), ohioState: value.ohioState + Number(game.winner === 'Ohio State'), ties: value.ties + Number(game.winner === 'Tie') }), { michigan: 0, ohioState: 0, ties: 0 });
const since2012 = games.filter((game) => game.year >= 2012).reduce((value, game) => ({ michigan: value.michigan + Number(game.winner === 'Michigan'), ohioState: value.ohioState + Number(game.winner === 'Ohio State') }), { michigan: 0, ohioState: 0 });
const date = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).format(now);
const heroes = [
  { src: '/images/Sad-Michigan-fans.jpg', alt: 'Dejected Michigan fans in the stands', caption: 'Ann Arbor, moments after the final whistle.' },
  { src: '/images/pitiful-michigan-fans.jpg', alt: 'Michigan fans looking pitiful', caption: 'The traditional November expression.' },
  { src: '/images/HMDSMHBOS-2.jpeg', alt: 'Ohio State celebration', caption: 'Scarlet and gray, as it should be.' },
  { src: '/images/mo-carmen-smile.png', alt: 'Mo smiling in Ohio State gear', caption: 'Mo approves of the current count.' },
];
---
<SiteShell active="count" title="How Many Days Since Michigan Has Beaten Ohio State?" description="The live Ohio State-Michigan day count, rivalry record, and evidence-labeled Rivalry Lab.">
  <ShareGraphic referenceDate="2024-11-30T17:00:00Z" siteUrl="https://howmanydayssincemichiganhasbeatenohiostate.com" />
  <section class="count"><h1>HOW MANY DAYS SINCE <span class="mich">MICHIGAN</span> HAS BEATEN <span class="osu">OHIO STATE</span>?</h1><p class="date">{date}</p><p class="counter" aria-live="polite"><strong id="days_count">{days.toLocaleString()}</strong> <span>DAYS</span></p><p class="last">Last <b class="mich">Michigan</b> win: November 30, 2024 - 13-10, Columbus.<br />Last <b class="osu">Ohio State</b> win: November 29, 2025 - 27-9, Ann Arbor.</p></section>
  <section class="stat-box"><div><strong class="osu">OSU 27-9</strong><small>THE GAME, 2025 · ANN ARBOR</small></div><div><strong>{totals.michigan}-{totals.ohioState}-{totals.ties}</strong><small>ALL-TIME SERIES (M-OSU-T), 1897-2025</small></div><div><strong class="osu">{since2012.ohioState}-{since2012.michigan}</strong><small>OHIO STATE SINCE 2012</small></div></section>
  <figure class="hero"><img src={heroes[0].src} alt={heroes[0].alt} data-hero-image /><figcaption data-hero-caption>{heroes[0].caption}</figcaption><button data-hero>ANOTHER ONE ↻</button></figure>
  <script define:vars={{ heroes }}>let index=0; document.querySelector('[data-hero]')?.addEventListener('click',()=>{index=(index+1)%heroes.length; const hero=heroes[index]; const image=document.querySelector('[data-hero-image]'); if(image){image.setAttribute('src',hero.src);image.setAttribute('alt',hero.alt)}; const caption=document.querySelector('[data-hero-caption]'); if(caption) caption.textContent=hero.caption;});</script>
</SiteShell>
