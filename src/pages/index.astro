---
import ShareGraphic from '../components/ShareGraphic.astro';
import SiteShell from '../components/SiteShell.astro';
import games from '../data/rivalry-games.json';
import { calcDaysSince } from '../lib/days';
import { nextRivalryGame } from '../lib/next-rivalry-game';

const referenceDate = new Date('2024-11-30T17:00:00Z');
const now = new Date();
const days = calcDaysSince(referenceDate, now);
const totals = games.reduce((value, game) => ({ michigan: value.michigan + Number(game.winner === 'Michigan'), ohioState: value.ohioState + Number(game.winner === 'Ohio State'), ties: value.ties + Number(game.winner === 'Tie') }), { michigan: 0, ohioState: 0, ties: 0 });
const since2012 = games.filter((game) => game.year >= 2012).reduce((value, game) => ({ michigan: value.michigan + Number(game.winner === 'Michigan'), ohioState: value.ohioState + Number(game.winner === 'Ohio State') }), { michigan: 0, ohioState: 0 });
const date = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).format(now);
---
<SiteShell active="count" title="How Many Days Since Michigan Has Beaten Ohio State?" description="The live Ohio State-Michigan day count, rivalry record, and evidence-labeled Rivalry Lab.">
  <ShareGraphic referenceDate="2024-11-30T17:00:00Z" siteUrl="https://howmanydayssincemichiganhasbeatenohiostate.com" />
  <section class="count" data-live-count data-reference-date="2024-11-30T17:00:00Z"><h1>HOW MANY DAYS SINCE <span class="mich">MICHIGAN</span> HAS BEATEN <span class="osu">OHIO STATE</span>?</h1><p class="date" data-current-date>{date}</p><p class="counter" aria-live="polite"><strong id="days_count">{days.toLocaleString()}</strong> <span>DAYS</span></p><p class="last">Last <b class="mich">Michigan</b> win: November 30, 2024 - 13-10, Columbus.<br />Last <b class="osu">Ohio State</b> win: November 29, 2025 - 27-9, Ann Arbor.<br /><a class="next-game-link" href="/countdown"><b>NEXT GAME:</b> {nextRivalryGame.date} - <span class="osu">{nextRivalryGame.location}</span>.</a></p></section>
  <section class="stat-box"><div><strong class="osu">OSU 27-9</strong><small>THE GAME, 2025 · ANN ARBOR</small></div><div><strong>{totals.michigan}-{totals.ohioState}-{totals.ties}</strong><small>ALL-TIME SERIES (M-OSU-T), 1897-2025</small></div><div><strong class="osu">{since2012.ohioState}-{since2012.michigan}</strong><small>OHIO STATE SINCE 2012</small></div></section>
  <section class="featured-merch" aria-labelledby="merch-heading"><img src="/images/products/script-in-the-snow.jpg" alt="Script in the Snow 2025 Rivalry Game commemorative tee" /><div><p>RIVALRY LAB MERCH</p><h2 id="merch-heading">SCRIPT IN THE SNOW</h2><span>THE 2025 RIVALRY GAME COMMEMORATIVE TEE</span><a href="https://gwpworkshop.com/products/script-in-the-snow-the-2025-rivalry-game-commemorative-tee" target="_blank" rel="noopener noreferrer">SHOP THE 2025 COMMEMORATIVE TEE →</a></div></section>
</SiteShell>

<script>
  const liveCount = document.querySelector<HTMLElement>('[data-live-count]');
  const referenceDate = new Date(liveCount?.dataset.referenceDate ?? '');
  const count = document.getElementById('days_count');
  const currentDate = document.querySelector<HTMLElement>('[data-current-date]');
  const renderCurrentTime = () => {
    const now = new Date();
    const days = Math.max(Math.floor((now.getTime() - referenceDate.getTime()) / 86_400_000), 0);
    if (count) count.textContent = days.toLocaleString('en-US');
    if (currentDate) currentDate.textContent = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).format(now);
  };
  renderCurrentTime();
  setInterval(renderCurrentTime, 60_000);
</script>

<style>
  .count h1 { font-size: 42.5px; }
  .next-game-link { color:inherit; text-decoration:none; }
  .next-game-link:hover,.next-game-link:focus-visible { text-decoration:none; }
  .next-game-link:hover .osu,.next-game-link:focus-visible .osu { background:#bb0000; color:#d9dce1; }
  .featured-merch { display:grid; grid-template-columns:minmax(0, 1fr) minmax(0, 1fr); gap:0; margin:32px 0; border:3px solid #111; }
  .featured-merch img { width:100%; height:100%; min-height:280px; object-fit:cover; }
  .featured-merch div { display:flex; flex-direction:column; justify-content:center; padding:36px; }
  .featured-merch p,.featured-merch span { color:#6b717c; font-size:12px; font-weight:700; letter-spacing:.06em; }
  .featured-merch p { margin:0 0 10px; color:#bb0000; }
  .featured-merch h2 { margin:0 0 10px; font:34px 'Archivo Black'; line-height:1; }
  .featured-merch a { align-self:flex-start; margin-top:24px; padding:12px 16px; background:#bb0000; color:#fff; font-size:12px; font-weight:700; text-decoration:none; }
  @media (max-width:640px) { .featured-merch { grid-template-columns:1fr; } .featured-merch img { min-height:0; } .featured-merch div { padding:26px; } }
</style>
