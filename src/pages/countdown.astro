---
import SiteShell from '../components/SiteShell.astro';
import { nextRivalryGame } from '../lib/next-rivalry-game';

const [firstTeam, secondTeam] = nextRivalryGame.name.toUpperCase().split(' VS. ');
const teamChipClass = (team: string) => team.includes('OHIO') ? 'osu' : 'mich';
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: nextRivalryGame.name,
  startDate: nextRivalryGame.start,
  location: {
    '@type': 'Place',
    name: nextRivalryGame.location,
    address: { '@type': 'PostalAddress', addressLocality: nextRivalryGame.location, addressRegion: 'OH', addressCountry: 'US' },
  },
};
---

<SiteShell active="countdown" title="Countdown to The Game | Ohio State vs Michigan" description="A live countdown to the 2026 Ohio State-Michigan game in Columbus." schema={eventSchema}>
  <section class="countdown" data-countdown data-game-start={nextRivalryGame.start}>
    <p class="eyebrow"><span class:list={['eyebrow-team', teamChipClass(firstTeam)]}>{firstTeam}</span> VS. <span class:list={['eyebrow-team', teamChipClass(secondTeam)]}>{secondTeam}</span></p>
    <h1>THE GAME</h1>
    <p class="kickoff">{nextRivalryGame.date.toUpperCase()} · {nextRivalryGame.time.toUpperCase()} · {nextRivalryGame.location.toUpperCase()}</p>
    <div class="countdown-clock" aria-live="polite" aria-label="Time remaining until The Game">
      <div><strong data-countdown-days>0</strong><span>DAYS</span></div>
      <div><strong data-countdown-hours>00</strong><span>HOURS</span></div>
      <div><strong data-countdown-minutes>00</strong><span>MINUTES</span></div>
      <div><strong data-countdown-seconds>00</strong><span>SECONDS</span></div>
    </div>
  </section>
</SiteShell>

<script>
  const countdown = document.querySelector<HTMLElement>('[data-countdown]');
  const gameStart = new Date(countdown?.dataset.gameStart ?? '').getTime();
  const days = document.querySelector<HTMLElement>('[data-countdown-days]');
  const hours = document.querySelector<HTMLElement>('[data-countdown-hours]');
  const minutes = document.querySelector<HTMLElement>('[data-countdown-minutes]');
  const seconds = document.querySelector<HTMLElement>('[data-countdown-seconds]');

  const render = () => {
    const remaining = Math.max(gameStart - Date.now(), 0);
    const totalSeconds = Math.floor(remaining / 1_000);
    if (days) days.textContent = String(Math.floor(totalSeconds / 86_400));
    if (hours) hours.textContent = String(Math.floor(totalSeconds % 86_400 / 3_600)).padStart(2, '0');
    if (minutes) minutes.textContent = String(Math.floor(totalSeconds % 3_600 / 60)).padStart(2, '0');
    if (seconds) seconds.textContent = String(totalSeconds % 60).padStart(2, '0');
  };

  render();
  setInterval(render, 1_000);
</script>

<style>
   :global(main.site-main) { display:flex; flex-direction:column; min-height:calc(100dvh - 142px); padding-bottom:0; }
   .countdown { --team:#bb0000; --team-shadow:#d9dce1; display:flex; flex:1; flex-direction:column; justify-content:center; max-width:900px; width:100%; margin:0 auto; padding:36px 0 48px; text-align:center; }
  .eyebrow,.kickoff { color:#6b717c; font-size:13px; font-weight:700; letter-spacing:.06em; }
  .countdown h1 { margin:8px 0; font:clamp(42px, 9vw, 94px)/.9 'Archivo Black'; letter-spacing:-.04em; }
  .eyebrow { font-size:19.5px; }
   .eyebrow-team { padding:3px 9px; }
   .eyebrow-team.osu { background:#bb0000; color:#d9dce1; }
   .eyebrow-team.mich { background:#00274c; color:#ffcb05; }
  .kickoff { margin:0; }
   .countdown-clock { display:grid; grid-template-columns:repeat(4,1fr); margin:36px 0 0; border:3px solid #111; }
  .countdown-clock div { padding:22px 12px; border-right:1px solid #d9dce1; }
  .countdown-clock div:last-child { border:0; }
   .countdown-clock strong { display:block; color:var(--team); font:clamp(52px, 13vw, 128px)/.85 'Archivo Black'; letter-spacing:-.06em; text-shadow:4px 4px var(--team-shadow); }
  .countdown-clock span { display:block; margin-top:12px; font-size:12px; font-weight:700; letter-spacing:.08em; }
  @media (max-width:640px) { .countdown { padding-top:18px; } .countdown-clock div { padding:18px 4px; } }
</style>
