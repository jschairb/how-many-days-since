---
import SiteShell from '../../components/SiteShell.astro';
import games from '../../data/rivalry-games.json';
import { rivalrySnapshot } from '../../lib/rivalry-snapshot';
import { sideClass, teamIdFor, teamSeasonFor, type RivalrySide, type RivalryTeam } from '../../lib/rivalry-archive';

export const prerender = true;
export function getStaticPaths() { return games.map((game) => ({ params: { year: String(game.year) }, props: { game } })); }

type Game = typeof games[number];
const game = Astro.props.game as Game;
const winner = game.winner as RivalryTeam;
const loser = game.loser as RivalryTeam;
// The hero's team colors go through `sideClass` so the six tied meetings read
// as neutral ink instead of falling through `teamIdFor` into Michigan navy.
const winnerClass = sideClass(game.winner as RivalrySide);
const loserClass = sideClass(game.loser as RivalrySide);
const winnerSeason = teamSeasonFor(teamIdFor(winner), game.year);
const loserSeason = teamSeasonFor(teamIdFor(loser), game.year);
const cfbdGame = rivalrySnapshot.rivalryGames.find((entry) => entry.season === game.year);
const index = games.findIndex((entry) => entry.year === game.year);
const nextMeeting = index > 0 ? games[index - 1] : undefined;
const previousMeeting = index < games.length - 1 ? games[index + 1] : undefined;
const rank = (value: number | null) => value === null ? 'UNRANKED / NOT REPORTED' : `NO. ${value}`;
---

<SiteShell active="record" title={`${game.year} ${winner} vs ${loser} | Ohio State-Michigan`} description={`The ${game.year} Ohio State-Michigan rivalry meeting: ${winner} ${game.wScore}, ${loser} ${game.lScore}.`}>
  <article class="archive-page game-archive">
    <a class="archive-back" href="/record">← EVERY MEETING</a>
    <header class="game-hero"><span>RIVALRY MEETING · {game.year}</span><h1 data-testid="game-score"><span class={winnerClass}>{winner.toUpperCase()}</span> {game.wScore}<i>–</i>{game.lScore} <span class={loserClass}>{loser.toUpperCase()}</span></h1><small>{game.date ?? 'DATE NOT REPORTED'} · {game.location ?? 'LOCATION NOT REPORTED'}{game.notes ? ` · ${game.notes}` : ''}</small></header>
    <section class="archive-panel" data-testid="game-facts"><div class="section-title"><h2>GAME FACTS</h2><span>ARCHIVED RESULT</span></div><dl class="game-facts"><div><dt>Date</dt><dd>{game.date ?? 'NOT REPORTED'}</dd></div><div><dt>Location</dt><dd>{game.location ?? 'NOT REPORTED'}</dd></div><div><dt>{winner} rank</dt><dd>{rank(game.wRank)}</dd></div><div><dt>{loser} rank</dt><dd>{rank(game.lRank)}</dd></div>{game.notes && <div><dt>Notes</dt><dd>{game.notes}</dd></div>}</dl></section>
    <section class="archive-panel"><div class="section-title"><h2>TEAM SEASONS</h2><span>PUBLIC SNAPSHOT</span></div><div class="team-links">{winnerSeason ? <a class={teamIdFor(winner) === 'ohio-state' ? 'osu' : 'mich'} href={`/teams/${teamIdFor(winner)}/${game.year}`} aria-label={`${winner} ${game.year} season`} data-track-event="team_season_opened" data-track-properties={JSON.stringify({ team: teamIdFor(winner), season: game.year })}>{winner} {game.year} season →</a> : <p>{winner} {game.year} season profile is not in the public snapshot.</p>}{loserSeason ? <a class={teamIdFor(loser) === 'ohio-state' ? 'osu' : 'mich'} href={`/teams/${teamIdFor(loser)}/${game.year}`} aria-label={`${loser} ${game.year} season`} data-track-event="team_season_opened" data-track-properties={JSON.stringify({ team: teamIdFor(loser), season: game.year })}>{loser} {game.year} season →</a> : <p>{loser} {game.year} season profile is not in the public snapshot.</p>}</div></section>
    <section class="archive-panel"><div class="section-title"><h2>ADVANCED BOXSCORE</h2><span>EXTERNAL SOURCE</span></div>{cfbdGame ? <p><a class="archive-button" href={cfbdGame.cfbdBoxscoreUrl} target="_blank" rel="noopener noreferrer" data-track-event="cfbd_boxscore_opened" data-track-properties={JSON.stringify({ game_year: game.year })}>CFBD ADVANCED BOX SCORE →</a></p> : <p>Advanced boxscore data is not included in the public snapshot for this meeting.</p>}</section>
    <nav class="meeting-nav" aria-label="Adjacent rivalry meetings">{nextMeeting && <a href={`/record/${nextMeeting.year}`}>NEXT MEETING: {nextMeeting.year} →</a>}{previousMeeting && <a href={`/record/${previousMeeting.year}`}>← PREVIOUS MEETING: {previousMeeting.year}</a>}</nav>
  </article>
</SiteShell>

<script>
  import { trackMarkedLinks } from '../../lib/client/analytics';

  trackMarkedLinks();
</script>

<style>
  .archive-page { max-width:900px; margin:auto; }.archive-back { display:inline-block; margin-bottom:24px; color:#111; font-size:12px; font-weight:700; letter-spacing:.05em; text-decoration:none; }.game-hero { padding:28px; border:3px solid #111; }.game-hero > span,.game-hero small,.section-title span { color:#6b717c; font-size:11px; font-weight:700; letter-spacing:.06em; }.game-hero h1 { display:flex; flex-wrap:wrap; gap:12px; align-items:baseline; margin:10px 0; font:clamp(30px,5.4vw,62px)/.95 'Archivo Black'; letter-spacing:-.04em; }.game-hero h1 i { color:#6b717c; font-style:normal; }.game-hero small { color:#111; }.archive-panel { margin-top:22px; padding:24px; border:3px solid #111; }.section-title { display:flex; justify-content:space-between; gap:16px; align-items:baseline; }.section-title h2 { margin:0; font:24px 'Archivo Black'; }.game-facts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 20px; margin:18px 0 0; }.game-facts div { padding:10px 0; border-top:1px solid #d9dce1; }.game-facts dt { color:#6b717c; font-size:12px; }.game-facts dd { margin:3px 0 0; font-weight:700; }.team-links { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; margin-top:18px; }.team-links a { padding:16px; border:2px solid currentColor; font-weight:700; text-decoration:none; }.team-links p { margin:0; color:#6b717c; font-size:13px; }.archive-button { display:inline-block; padding:10px 12px; background:#111; color:#fff; font-size:12px; font-weight:700; text-decoration:none; }.meeting-nav { display:flex; justify-content:space-between; gap:16px; margin-top:24px; }.meeting-nav a { color:#111; font-size:12px; font-weight:700; text-decoration:none; } @media (max-width:640px) { .game-hero,.archive-panel { padding:18px; }.game-hero h1 { gap:8px; }.game-facts,.team-links { grid-template-columns:1fr; }.meeting-nav { flex-direction:column; } }
</style>
