---
import SiteShell from '../components/SiteShell.astro'; import games from '../data/rivalry-games.json';
const totals = games.reduce((value, game) => ({ michigan: value.michigan + Number(game.winner === 'Michigan'), ohioState: value.ohioState + Number(game.winner === 'Ohio State'), ties: value.ties + Number(game.winner === 'Tie') }), { michigan: 0, ohioState: 0, ties: 0 });
const decades = Object.entries(games.reduce<Record<string, { michigan: number; ohioState: number }>>((value, game) => { const decade = `${Math.floor(game.year / 10) * 10}`; value[decade] ??= { michigan: 0, ohioState: 0 }; if (game.winner === 'Michigan') value[decade].michigan++; if (game.winner === 'Ohio State') value[decade].ohioState++; return value; }, {})).sort(([a], [b]) => Number(a) - Number(b));
---
<SiteShell active="record" title="The Record | Ohio State vs Michigan" description="All 121 Ohio State-Michigan meetings from 1897 through 2025, with rivalry results by decade."><section class="record"><div class="section-title"><h1>THE RECORD</h1><span>121 MEETINGS · 1897-2025</span></div><section class="tally"><div><strong class="mich">{totals.michigan}</strong><small>MICHIGAN WINS</small></div><div><strong class="osu">{totals.ohioState}</strong><small>OHIO STATE WINS</small></div><div><strong>{totals.ties}</strong><small>TIES</small></div></section><section><div class="section-title"><b>WINS BY DECADE</b><span>TREND: HISTORICAL RESULTS</span></div><div class="decades">{decades.map(([decade, wins]) => <div class="decade" title={`${decade}s: Michigan ${wins.michigan}, Ohio State ${wins.ohioState}`}><i class="m" style={`height:${wins.michigan * 9}px`}></i><i class="o" style={`height:${wins.ohioState * 9}px`}></i></div>)}</div></section><section><div class="record-filter"><b>EVERY MEETING</b><input aria-label="Filter games" placeholder="Filter by year, team, or site..." data-filter /></div><div class="game-table" data-games>{games.map((game) => <div class="game-row" data-game={`${game.year} ${game.winner} ${game.location}`.toLowerCase()}><b>{game.year}</b><b class:list={{ mich: game.winner === 'Michigan', osu: game.winner === 'Ohio State' }}>{game.winner}</b><span>{game.wScore}-{game.lScore}</span><span>{game.location}</span></div>)}</div></section></section><script>document.querySelector('[data-filter]')?.addEventListener('input',(event)=>{const query=(event.currentTarget as HTMLInputElement).value.toLowerCase();document.querySelectorAll<HTMLElement>('[data-game]').forEach((row)=>row.hidden=!row.dataset.game!.includes(query));});</script></SiteShell>
