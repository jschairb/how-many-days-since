---
import SiteShell from '../components/SiteShell.astro';
import games from '../data/rivalry-games.json';
import { calculateRivalryRecord, type RivalryGame, type Team } from '../lib/rivalry-record';

const totals = games.reduce(
  (value, game) => ({
    michigan: value.michigan + Number(game.winner === 'Michigan'),
    ohioState: value.ohioState + Number(game.winner === 'Ohio State'),
    ties: value.ties + Number(game.winner === 'Tie'),
  }),
  { michigan: 0, ohioState: 0, ties: 0 }
);
const decades = Object.entries(games.reduce<Record<string, { michigan: number; ohioState: number }>>((value, game) => { const decade = `${Math.floor(game.year / 10) * 10}`; value[decade] ??= { michigan: 0, ohioState: 0 }; if (game.winner === 'Michigan') value[decade].michigan++; if (game.winner === 'Ohio State') value[decade].ohioState++; return value; }, {})).sort(([a], [b]) => Number(a) - Number(b));
const droughtRecord = calculateRivalryRecord(games);
const ohioStateDroughts = droughtRecord.byTeam['Ohio State'];
const michiganDroughts = droughtRecord.byTeam.Michigan;
const currentDrought = [ohioStateDroughts.currentActiveDrought, michiganDroughts.currentActiveDrought].find(Boolean);
const number = new Intl.NumberFormat('en-US');
const formatDays = (days: number) => `${number.format(Math.round(days))} DAYS`;
const formatResult = (game: RivalryGame) => `${game.winner} ${game.wScore}-${game.lScore} ${game.loser}`;
const teamClass = (team: Team) => team === 'Ohio State' ? 'osu' : 'mich';
---

<SiteShell active="record" title="The Record | Ohio State vs Michigan" description="All 121 Ohio State-Michigan meetings from 1897 through 2025, with rivalry results by decade.">
  <section class="record">
    <div class="section-title"><h1>THE RECORD</h1><span>121 MEETINGS · 1897-2025</span></div>
    <section class="tally">
      <div><strong class="mich">{totals.michigan}</strong><small>MICHIGAN WINS</small></div>
      <div><strong class="osu">{totals.ohioState}</strong><small>OHIO STATE WINS</small></div>
      <div><strong>{totals.ties}</strong><small>TIES</small></div>
    </section>
    <section>
      <div class="section-title"><b>WINS BY DECADE</b><span>TREND: HISTORICAL RESULTS</span></div>
      <div class="decades">{decades.map(([decade, wins]) => <div class="decade" title={`${decade}s: Michigan ${wins.michigan}, Ohio State ${wins.ohioState}`}><i class="m" style={`height:${wins.michigan * 9}px`}></i><i class="o" style={`height:${wins.ohioState * 9}px`}></i></div>)}</div>
    </section>
    <section class="droughts" aria-labelledby="droughts-heading">
      <div class="section-title"><h2 id="droughts-heading">RIVALRY DROUGHTS</h2><span>OBSERVED · PUBLIC GAME RESULTS</span></div>
      <div class="drought-summary" aria-label="Rivalry drought highlights">
        <div>
          <strong class:list={{ [teamClass(currentDrought!.team)]: true }}>{formatDays(currentDrought!.elapsedDays)}</strong>
          <small>CURRENT {currentDrought!.team.toUpperCase()} DROUGHT<br />SINCE {currentDrought!.startResult.winner.toUpperCase()} {currentDrought!.startResult.year}</small>
        </div>
        <div data-testid="ohio-state-longest">
          <strong class="osu">{formatDays(ohioStateDroughts.longest.elapsedDays)}</strong>
          <small>LONGEST OHIO STATE DROUGHT<br />{ohioStateDroughts.longest.priorWin.year} TO {ohioStateDroughts.longest.nextWin.year}</small>
        </div>
        <div>
          <strong class="mich">{formatDays(michiganDroughts.longest.elapsedDays)}</strong>
          <small>LONGEST MICHIGAN DROUGHT<br />{michiganDroughts.longest.priorWin.year} TO {michiganDroughts.longest.nextWin.year}</small>
        </div>
      </div>
      <div class="drought-table-wrap drought-comparison-wrap">
        <table class="drought-comparison">
          <caption>Observed completed drought statistics for Ohio State and Michigan</caption>
          <thead><tr><th scope="col">COMPLETED DROUGHTS</th><th scope="col" class="osu">OHIO STATE</th><th scope="col" class="mich">MICHIGAN</th></tr></thead>
          <tbody>
            <tr><th scope="row">Completed drought count</th><td>{ohioStateDroughts.completedDroughts.length}</td><td>{michiganDroughts.completedDroughts.length}</td></tr>
            <tr><th scope="row">Average length</th><td>{formatDays(ohioStateDroughts.averageDays)}</td><td>{formatDays(michiganDroughts.averageDays)}</td></tr>
            <tr><th scope="row">Median length</th><td>{formatDays(ohioStateDroughts.medianDays)}</td><td>{formatDays(michiganDroughts.medianDays)}</td></tr>
            <tr><th scope="row">Shortest completed drought</th><td>{formatDays(ohioStateDroughts.shortest.elapsedDays)}</td><td>{formatDays(michiganDroughts.shortest.elapsedDays)}</td></tr>
            <tr><th scope="row">Longest completed drought</th><td>{formatDays(ohioStateDroughts.longest.elapsedDays)}</td><td>{formatDays(michiganDroughts.longest.elapsedDays)}</td></tr>
          </tbody>
        </table>
      </div>
      <div class="section-title drought-subhead"><b>TOP FIVE LONGEST DROUGHTS</b><span>CALENDAR DAYS BETWEEN WINS</span></div>
      <div class="drought-table-wrap" data-drought-table="longest">
        <table class="drought-list">
          <caption>Five longest observed completed droughts in the rivalry</caption>
          <thead><tr><th scope="col">TEAM</th><th scope="col">START RESULT / YEAR</th><th scope="col">ENDING RESULT / YEAR</th><th scope="col">ELAPSED DAYS</th><th scope="col">GAMES / SEASONS</th></tr></thead>
          <tbody>{droughtRecord.topFiveLongestDroughts.map((drought) => <tr><th scope="row" class={teamClass(drought.team)}>{drought.team}</th><td>{formatResult(drought.priorWin)}<br /><small>{drought.priorWin.year}</small></td><td>{formatResult(drought.nextWin)}<br /><small>{drought.nextWin.year}</small></td><td>{formatDays(drought.elapsedDays)}</td><td>{drought.elapsedGames} GAMES / {drought.elapsedSeasons} SEASONS</td></tr>)}</tbody>
        </table>
      </div>
      <div class="section-title drought-subhead"><b>DROUGHT HISTORY</b><span>LOSING SIDE'S DAYS SINCE ITS PRIOR WIN</span></div>
      <div class="drought-table-wrap" data-drought-table="history">
        <table class="drought-history">
          <caption>Game-by-game observed drought history</caption>
          <thead><tr><th scope="col">YEAR</th><th scope="col">RESULT</th><th scope="col">LOSING SIDE</th><th scope="col">DAYS SINCE PRIOR WIN</th></tr></thead>
          <tbody>{droughtRecord.droughtHistory.map((entry) => <tr><th scope="row">{entry.game.year}</th><td class:list={{ osu: entry.game.winner === 'Ohio State', mich: entry.game.winner === 'Michigan' }}>{entry.game.winner === 'Tie' ? 'TIE' : formatResult(entry.game)}</td><td>{entry.losingTeam ?? '—'}</td><td>{entry.daysSincePriorWin === null ? '—' : formatDays(entry.daysSincePriorWin)}</td></tr>)}</tbody>
        </table>
      </div>
    </section>
    <section>
      <div class="record-filter"><b>EVERY MEETING</b><input aria-label="Filter games" placeholder="Filter by year, team, or site..." data-filter /></div>
      <div class="game-table" data-games>{games.map((game) => <div class="game-row" data-game={`${game.year} ${game.winner} ${game.location}`.toLowerCase()}><b>{game.year}</b><b class:list={{ mich: game.winner === 'Michigan', osu: game.winner === 'Ohio State' }}>{game.winner}</b><span>{game.wScore}-{game.lScore}</span><span>{game.location}</span></div>)}</div>
    </section>
  </section>
  <script>document.querySelector('[data-filter]')?.addEventListener('input', (event) => { const query = (event.currentTarget as HTMLInputElement).value.toLowerCase(); document.querySelectorAll<HTMLElement>('[data-game]').forEach((row) => row.hidden = !row.dataset.game!.includes(query)); });</script>
</SiteShell>

<style>
  .droughts { margin-top:48px; }
  .droughts h2 { margin:0; font:24px 'Archivo Black'; letter-spacing:-.02em; }
  .drought-summary { display:grid; grid-template-columns:repeat(3, 1fr); margin:16px 0 28px; border:3px solid #111; }
  .drought-summary > div { min-height:126px; padding:18px; border-right:1px solid #d9dce1; }
  .drought-summary > div:last-child { border-right:0; }
  .drought-summary strong { display:block; margin-bottom:8px; font:clamp(23px, 2.7vw, 34px) 'Archivo Black'; line-height:1; }
  .drought-summary small, .drought-list small { color:#6b717c; font-size:11px; font-weight:700; line-height:1.35; letter-spacing:.03em; }
  .drought-table-wrap { overflow-x:auto; margin:0 0 28px; border:3px solid #111; -webkit-overflow-scrolling:touch; }
  .drought-comparison-wrap { overflow:hidden; }
  .drought-comparison, .drought-list, .drought-history { width:100%; border-collapse:collapse; }
  .drought-comparison caption, .drought-list caption, .drought-history caption { padding:12px 16px; border-bottom:1px solid #d9dce1; text-align:left; color:#6b717c; font-size:12px; font-weight:700; }
  .drought-comparison th, .drought-comparison td, .drought-list th, .drought-list td, .drought-history th, .drought-history td { padding:12px 14px; border-right:1px solid #d9dce1; border-bottom:1px solid #d9dce1; text-align:left; font-size:13px; vertical-align:top; }
  .drought-comparison tr > :last-child, .drought-list tr > :last-child, .drought-history tr > :last-child { border-right:0; }
  .drought-comparison tbody tr:last-child > *, .drought-list tbody tr:last-child > *, .drought-history tbody tr:last-child > * { border-bottom:0; }
  .drought-comparison thead th, .drought-list thead th, .drought-history thead th { background:#f2f3f5; font-size:11px; letter-spacing:.04em; }
  .drought-comparison tbody th { width:48%; }
  .drought-comparison td { font-weight:700; }
  .drought-list { min-width:760px; }
  .drought-history { min-width:640px; }
  .drought-subhead { margin-top:36px; }
  @media (max-width:640px) { .drought-summary { grid-template-columns:1fr; } .drought-summary > div { min-height:0; border-right:0; border-bottom:1px solid #d9dce1; } .drought-summary > div:last-child { border-bottom:0; } .drought-comparison th, .drought-comparison td { padding:10px; font-size:12px; } .drought-comparison tbody th { width:42%; } }
</style>
