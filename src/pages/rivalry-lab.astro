---
import SiteShell from '../components/SiteShell.astro'; import LabApp from '../components/RivalryLab.astro'; import { rivalrySnapshot } from '../lib/rivalry-snapshot';
const osuYears = rivalrySnapshot.ratings.teamSeasons.filter((entry) => entry.teamId === 'ohio-state' && entry.srs).map((entry) => entry.season).sort((a,b) => b-a); const michYears = rivalrySnapshot.ratings.teamSeasons.filter((entry) => entry.teamId === 'michigan' && entry.srs).map((entry) => entry.season).sort((a,b) => b-a);
---
<SiteShell active="lab" title="Rivalry Lab"><LabApp {osuYears} {michYears} /></SiteShell>
